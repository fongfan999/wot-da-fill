{
	"name": "wot-da-fill",
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && node scripts/prerender.mjs",
		"preview": "vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"fonts:update": "node scripts/update-google-fonts.mjs",
		"showcase:update": "node scripts/render-showcase.mjs"
	},
	"dependencies": {
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/oxipng": "^2.3.0",
		"@jsquash/webp": "^1.5.0",
		"client-zip": "^2.5.1",
		"hono": "^4.13.17",
		"image-q": "^4.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.67.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"playwright-core": "^1.65.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.6",
		"wrangler": "^4.158.0"
	}
}
