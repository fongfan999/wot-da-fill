/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wot-da-fill",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-11-08",
	"routes": [{ "pattern": "fill.wotda.app", "custom_domain": true }],
	/**
	 * The React app is built by Vite (@cloudflare/vite-plugin) and served as static assets.
	 * The home pages are pre-rendered (scripts/prerender.mjs): / and /vi/. /api/* and /t/* (share links,
	 * which get the empty app.html) always hit the Worker; any other unknown path gets 404.html.
	 */
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*", "/t/*"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	/**
	 * Shared templates (design image + layout + custom fonts). Guest lists are never uploaded.
	 * Create once with: pnpm wrangler r2 bucket create wot-da-fill-templates
	 */
	"r2_buckets": [
		{
			"binding": "TEMPLATES",
			"bucket_name": "wot-da-fill-templates"
		}
	],
	/**
	 * There is no auth, so share uploads are rate limited per IP.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
	 */
	"ratelimits": [
		{
			"name": "SHARE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		}
	]
}
